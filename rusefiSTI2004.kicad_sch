	(lib_symbols)
	(text "Units: D = B137, C = B136, B = B135, A = B134. Every\npin carries a global net label used on the other\nsheets."
		(exclude_from_sim no)
		(at 15.24 95.25 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "17e037fd-f439-4a54-8eca-acb1a80a07a2")
	)
	(text "Built from Hellen-One modules. Signals between sheets are global net labels; power symbols are global.\nCrossed-out (DNP) parts are optional footprints, not assembled: what each one is for is in documents/README.md.\nCar pinout and cross-check: documents/STI2004-pinout-check.xlsx (tools/pinout_check.py).\nSheet order follows the signal: car connector -> power -> MCU -> inputs -> outputs -> comms -> aux."
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "1d550e5b-8407-4fb9-8087-bb0e0f45a421")
	)
	(text "M14 (main power module): +12V_RAW from the main\nrelay (B5/B6), +12V_IGN (D15), back-up +12V (B19)."
		(exclude_from_sim no)
		(at 110.49 95.25 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "42616b1f-f3ca-455a-b444-e3446e4a96ab")
	)
	(text "J3: Molex Mini-Fit Jr 2x7 (pinout in\ndocuments/README.md): fused 12 V and 5 V, sensor\nground, three digital"
		(exclude_from_sim no)
		(at 300.99 156.21 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "52628ba9-9e22-4d63-a194-ad68e725add3")
	)
	(text "M11/M12 (dinput4): car lines that close to ground\n(defogger D11, lights D12, blower D13, test mode\nD14,"
		(exclude_from_sim no)
		(at 15.24 156.21 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "63304620-a66d-414d-a213-11b9dcb2a61d")
	)
	(text "M3: rusEFI wideband (WBO) for a Bosch LSU 4.9 front\nO2, on CAN to M1. It reaches the sensor through the\nstock"
		(exclude_from_sim no)
		(at 205.74 156.21 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "78218469-0c52-4ec6-8457-40f10d182a8b")
	)
	(text "Crank: 2-wire VR sensor (B10 +, B22 -) into M5.\nKnock (C25) into M13. M7 is a spare knock channel\n(not used)."
		(exclude_from_sim no)
		(at 300.99 95.25 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "8ff9ceec-6e5a-492d-ad55-577af335474c")
	)
	(text "M1: Hellen mega-mcu144 (STM32F7), with a 120R CAN\nterminator built in."
		(exclude_from_sim no)
		(at 205.74 95.25 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "a11f5db3-c9c4-4540-ac3a-175258ef00fe")
	)
	(text "rusEFI STI 2004: plug-and-play ECU for the 2004 USDM Subaru Impreza WRX STI (EJ257, drive-by-wire)."
