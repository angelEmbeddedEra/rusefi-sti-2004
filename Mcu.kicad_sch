		(uuid "208d4dc6-0c9a-492c-96b6-87116c960739")
	)
	(text "M1: Hellen mega-mcu144 (STM32F7), with a 120R CAN terminator built in.\nJ2 USB-C for TunerStudio: 5.1k CC pull-downs (device), USBLC6-2SC6 ESD (U1), shell to GND through a 0R link.\nBOOT0 pad with an open link to 3.3 V forces the USB DFU bootloader; SWD pads (SWDIO, SWCLK, NRST) for a debugger."
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "adcc1b0c-65f8-48ab-ba4a-515d5445225e")
	)
